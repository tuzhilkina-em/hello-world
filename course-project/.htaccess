DirectoryIndex index.php
RewriteEngine On
RewriteRule ^(?:flight|vendor|\.course-data)(?:/|$) - [F,L]
RewriteRule ^(?:app|data|view|router)\.php$ - [F,L]
RewriteRule ^(?:composer\.json|README\.md|LICENSE-flight\.txt)$ - [F,L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [L]
